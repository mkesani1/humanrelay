# --- Server ---
PORT=8787
# Postgres connection string. Point at Supabase in production.
# Leave unset for local dev: runs on in-process PGlite.
DATABASE_URL=
# Admin API token (POST /admin/*). Generated and logged at boot if unset.
ADMIN_TOKEN=

# --- Relay ---
# "mock" (deterministic, no LLM calls) or "live" (Anthropic API)
RELAY_MODE=mock
# Required when RELAY_MODE=live
ANTHROPIC_API_KEY=

# --- MCP client (src/mcp/server.ts) ---
HUMANRELAY_BASE_URL=http://localhost:8787
HUMANRELAY_API_KEY=
